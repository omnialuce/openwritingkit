rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // inviteCodes: Allow unauthenticated reads for signup validation.
    // Writes are disallowed from the client to prevent tampering.
    match /inviteCodes/{inviteCode} {
      allow read: if true;
      allow write: if false; // Should only be written from the backend/admin
    }

    // activityLog: Client-side access is completely disallowed.
    // This collection should only be written to by your secure server-side flow.
    match /activityLog/{logId} {
        allow read, write: if false;
    }

    // Default rule: Disallow all access to other collections by default.
    // You should add specific rules for other collections as you build them.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
