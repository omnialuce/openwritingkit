# =============================================
# OpenWritingKit — Environment Variables
# Copy this file to .env.local and fill in values.
# =============================================

# --- Firebase Client SDK (public, safe to expose in browser) ---
# Get these from your Firebase project console → Project Settings → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Google OAuth (for social sign-in via NextAuth) ---
# Create credentials at console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Must match your deployment URL, e.g. http://localhost:3000 in development
NEXTAUTH_URL=http://localhost:3000

# --- Firebase Admin SDK (server-side only, never exposed to browser) ---
# Optional: required only if you use server-side Firestore operations.
# Paste the full JSON content of your Firebase service account key as a single line.
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# --- Sign-up Invite Code ---
# Users must enter this code to register. Leave blank to disable invite restriction.
INVITE_CODE=
