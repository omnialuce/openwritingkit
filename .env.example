# =============================================
# OpenWritingKit — Environment Variables
# Copy this file to .env.local and fill in values.
# =============================================

# --- Supabase (Auth + Cloud Storage) ---
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: service role key for server-side admin operations.
# Required only if you add backend tasks that need elevated privileges.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Sign-up Invite Code ---
# Users must enter this code to register. Leave blank to allow open signup.
# Validated server-side via /api/validate-invite (not exposed to the browser).
INVITE_CODE=

# --- Writing Feedback (LanguageTool) ---
# Optional: point at a self-hosted LanguageTool instance for fully private grammar checking.
# Omit or leave blank to use the public LanguageTool API (text is sent to languagetoolplus.com).
# NEXT_PUBLIC_LANGUAGETOOL_URL=http://localhost:8081/v2/check
